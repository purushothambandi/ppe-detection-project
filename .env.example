# Environment Configuration Template
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file — it is listed in .gitignore.

# --- Arduino / Hardware Settings ---
# Set this to your actual Arduino COM port (e.g. COM3, COM4, COM7, /dev/ttyUSB0)
ARDUINO_PORT=COM7
ARDUINO_BAUD_RATE=9600

# --- Roboflow (if used for dataset management) ---
# ROBOFLOW_API_KEY=your_roboflow_api_key_here

# --- Model Paths (override defaults if needed) ---
# MODEL_PATH=yolov5/models/ultimate_brain.pt
# PPE_MODEL_PATH=yolov5/kitchen_ppe_vision_v2.pt
